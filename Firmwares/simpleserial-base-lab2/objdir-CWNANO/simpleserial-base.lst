 106:simpleserial-base.c **** #if SS_VER == SS_VER_2_1
 107:simpleserial-base.c **** uint8_t aes(uint8_t cmd, uint8_t scmd, uint8_t len, uint8_t *buf)
 108:simpleserial-base.c **** {
 109:simpleserial-base.c ****     uint8_t req_len = 0;
 110:simpleserial-base.c ****     uint8_t err = 0;
 111:simpleserial-base.c **** 
 112:simpleserial-base.c ****     if (scmd & 0x02) {
 113:simpleserial-base.c ****         req_len += 16;
 114:simpleserial-base.c ****         if (req_len > len) {
 115:simpleserial-base.c ****             return SS_ERR_LEN;
 116:simpleserial-base.c ****         }
 117:simpleserial-base.c ****         err = get_key(buf + req_len - 16, 16);
 118:simpleserial-base.c ****         if (err)
 119:simpleserial-base.c ****             return err;
 120:simpleserial-base.c ****     }
 121:simpleserial-base.c ****     if (scmd & 0x01) {
 122:simpleserial-base.c ****         req_len += 16;
 123:simpleserial-base.c ****         if (req_len > len) {
 124:simpleserial-base.c ****             return SS_ERR_LEN;
 125:simpleserial-base.c ****         }
 126:simpleserial-base.c ****         err = get_pt(buf + req_len - 16, 16);
 127:simpleserial-base.c ****         if (err)
 128:simpleserial-base.c ****             return err;
 129:simpleserial-base.c ****     }
 130:simpleserial-base.c **** 
 131:simpleserial-base.c ****     if (len != req_len) {
 132:simpleserial-base.c ****         return SS_ERR_LEN;
 133:simpleserial-base.c ****     }
 134:simpleserial-base.c **** 
 135:simpleserial-base.c ****     return 0x00;
 136:simpleserial-base.c **** 
 137:simpleserial-base.c **** }
 138:simpleserial-base.c **** #endif
